CONFIG_IDF_TARGET="esp32c6"

# ESP32-C6-DevKitC/M-1 Settings
# Buttons
CONFIG_BSP_BUTTONS_NUM=1
CONFIG_BSP_BUTTON_1_TYPE_GPIO=y
CONFIG_BSP_BUTTON_1_GPIO=9
CONFIG_BSP_BUTTON_1_LEVEL=0

# Thermostat: WS2812 status LED on GPIO8, heating relay on GPIO2, cooling relay on GPIO3
CONFIG_THERMOSTAT_STATUS_LED_GPIO=8
CONFIG_THERMOSTAT_HEAT_RELAY_GPIO=2
CONFIG_THERMOSTAT_COOL_RELAY_GPIO=3
